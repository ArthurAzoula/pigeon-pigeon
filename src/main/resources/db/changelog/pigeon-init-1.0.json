{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "1",
        "author": "azoulux",
        "changes": [
          {
            "createTable": {
              "tableName": "player",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "uuid",
                    "defaultValueComputed": "gen_random_uuid()",
                    "constraints": {
                      "primaryKey": true,
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "email",
                    "type": "varchar(100)",
                    "constraints": {
                      "nullable": false,
                      "unique": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "pseudonym",
                    "type": "varchar(50)",
                    "constraints": {
                      "nullable": false,
                      "unique": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "password",
                    "type": "varchar(100)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "created_at",
                    "type": "timestamp",
                    "defaultValueComputed": "CURRENT_TIMESTAMP"
                  }
                }
              ]
            }
          }
        ]
      }
    },
